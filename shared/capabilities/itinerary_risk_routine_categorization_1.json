{
  "id": "itinerary_risk_routine_categorization_1",
  "pluginKey": "@official-plugins/ai-categorization",
  "pluginVersion": "1.0.21",
  "name": "行程风险套路分类识别",
  "description": "传入用户输入的行程文本和套路库分类参考，识别输出匹配的行程风险套路列表",
  "icon": "",
  "paramsSchema": {
    "type": "object",
    "properties": {
      "itinerary_text": {
        "type": "string",
        "description": "待分类的行程文本内容"
      },
      "routine_categories": {
        "type": "array",
        "description": "套路库分类参考列表",
        "items": {
          "type": "string",
          "description": "单个套路分类名称"
        }
      },
      "custom_classify_requirements": {
        "type": "string",
        "description": "自定义分类补充要求（可选）"
      }
    },
    "required": [
      "itinerary_text",
      "routine_categories"
    ]
  },
  "formValue": {
    "categories": "{{input.routine_categories}}",
    "customRequirements": "请根据提供的套路库分类，对行程文本进行风险套路识别，匹配所有符合的套路分类并输出。{{input.custom_classify_requirements}}",
    "modelID": "2015",
    "modelParams": {
      "maxTokens": 8192,
      "temperature": 0.5
    },
    "textToBeCategorized": "{{input.itinerary_text}}"
  },
  "createdAt": 1790914983158,
  "updatedAt": 1790914983158,
  "createdBy": 7524219092488814596
}